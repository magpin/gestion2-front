# Plantilla del entorno del frontend:
#
#   cp .env.example .env.local
#
# `.env.local` no se versiona. Este sí, para que se sepa qué hay que llenar.
# `NEXT_PUBLIC_*` se resuelve al construir, no al arrancar.

# La API, vista desde el navegador. En desarrollo apunta al backend local; en
# producción, al dominio real. Si se deja sin definir, el código cae a
# http://localhost:3001/api/v1 (src/core/config/env.ts).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
